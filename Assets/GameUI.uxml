<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="GameUI.uss" />
    <ui:Template name="NPCDialogueTemplate" src="NPCDialogue.uxml" />
    <ui:Template name="EndScreenTemplate" src="EndScreen.uxml" />
    <ui:VisualElement name="HealthBarBackground" class="health-frame" picking-mode="Ignore">
        <ui:VisualElement name="HealthBarContainer" class="health-container" picking-mode="Ignore">
            <ui:VisualElement name="HealthBar" class="health-bar" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="CharacterPortrait" class="portrait" picking-mode="Ignore" />
    </ui:VisualElement>
    <ui:VisualElement name="RobotCounterFrame" class="counter-frame" picking-mode="Ignore">
        <ui:Label name="RobotCounter" text="0 / 3" class="counter" />
    </ui:VisualElement>
    <ui:Label name="SwitchTimer" class="switch-timer" picking-mode="Ignore" />
    <ui:Instance template="NPCDialogueTemplate" class="dialogue-slot" picking-mode="Ignore" />
    <ui:Instance template="EndScreenTemplate" class="end-slot" picking-mode="Ignore" />
</ui:UXML>
